#!/bin/bash

# Aktuális git branch nevének lekérése
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Regex: első előforduló szám a branch névben
if [[ "$BRANCH_NAME" =~ ([0-9]+) ]]; then
  echo "${BASH_REMATCH[1]}"
else
  echo "Nincs jegy ID a branch névben: $BRANCH_NAME" >&2
  exit 1
fi