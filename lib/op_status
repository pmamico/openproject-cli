#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR"

if [ "$1" == "--summary" ]; then
  echo "Jegy információk ID alapján"
  exit 0
fi

if [ "$1" == "--desc" ]; then
  echo "Jegy részleteinek kiírása (projekt, státusz, felelős...)"
  exit 0
fi

if [ -n "$1" ]; then
  TICKET_ID="$1"
else
  if ! command -v "$LIB_DIR"/get_ticket_id >/dev/null 2>&1; then
    echo "Hiányzik a get_ticket_id parancs" >&2
    exit 1
  fi
  TICKET_ID=$("$LIB_DIR"/get_ticket_id)
  if [ -z "$TICKET_ID" ]; then
    echo "Nem sikerült meghatározni a jegy ID-t" >&2
    exit 1
  fi
fi

"$LIB_DIR"/api_get "/api/v3/work_packages/$TICKET_ID" | jq '
{
  projekt:      ._links.project.title,
  cim:          .subject,
  parent:       ._links.parent.title,
  parent_id:    ((._links.parent.href // "") | split("/") | last | if test("^[0-9]+$") then . else null end),
  verzio:       (._links.version.title // ""),
  assignee:     ._links.assignee.title,
  tipus:        ._links.type.title,
  status:       ._links.status.title,
  elorehaladas: .percentageDone,
  raforditas_ora: .spentTime
}'
