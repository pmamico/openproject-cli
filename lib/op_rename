#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
LIB_DIR="$SCRIPT_DIR"

if [ "${1:-}" == "--summary" ]; then
  echo "Jegy cim atirasa"
  exit 0
fi

if [ "${1:-}" == "--desc" ]; then
  echo "Hasznalat: op rename <work_package_id> \"Uj cim\" - Atirja a megadott jegy cimet."
  exit 0
fi

if [ $# -ne 2 ]; then
  echo "Hasznalat: op rename <work_package_id> \"Uj cim\"" >&2
  exit 1
fi

TICKET_ID="$1"
NEW_TITLE="$2"

if ! [[ "$TICKET_ID" =~ ^[0-9]+$ ]]; then
  echo "Ervenytelen jegy ID: $TICKET_ID" >&2
  exit 1
fi

if [ -z "$NEW_TITLE" ]; then
  echo "Az uj cim nem lehet ures" >&2
  exit 1
fi

WORK_PACKAGE_JSON="$($LIB_DIR/api_get "/api/v3/work_packages/$TICKET_ID")"
LOCK_VERSION="$(echo "$WORK_PACKAGE_JSON" | jq -r '.lockVersion')"

if [ -z "$LOCK_VERSION" ] || [ "$LOCK_VERSION" = "null" ]; then
  echo "Nem sikerult lekerdezni a lockVersion erteket a jegyhez (#$TICKET_ID)" >&2
  exit 1
fi

PAYLOAD="$(jq -n --arg subject "$NEW_TITLE" --argjson lockVersion "$LOCK_VERSION" '{
  lockVersion: $lockVersion,
  subject: $subject
}')"

RESP="$($LIB_DIR/api_patch "/api/v3/work_packages/$TICKET_ID" "$PAYLOAD")"
UPDATED_TITLE="$(echo "$RESP" | jq -r '.subject // empty' 2>/dev/null || true)"

if [ -z "$UPDATED_TITLE" ]; then
  MSG="$(echo "$RESP" | jq -r '.message // empty' 2>/dev/null || true)"
  if [ -n "$MSG" ]; then
    echo "Hiba az atnevezes kozben: $MSG" >&2
  else
    echo "Hiba az atnevezes kozben. Szerver valasz:" >&2
    echo "$RESP" >&2
  fi
  exit 1
fi

echo "#$TICKET_ID renamed to: $UPDATED_TITLE"
