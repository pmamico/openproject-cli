#!/bin/bash

# Interactive review over items produced by op_list.
# Lets you update: status, percentageDone, priority, work estimate.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
LIB_DIR="$SCRIPT_DIR"

if [ "$1" == "--summary" ]; then
  echo "Interaktív felülvizsgálat: az op_list által hozott jegyekre rákérdez, és módosítható a status, percentageDone, priority, work"
  exit 0
fi

if [ "$1" == "--desc" ]; then
  echo "Az op_list kimenetén iterálva sorban megjeleníti a jegyeket, és lehetővé teszi a státusz, készültség (percentageDone), prioritás és becslés (work) módosítását."
  exit 0
fi

# --- Helpers ---

err() { echo "$*" >&2; }

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    err "Hiányzó parancs: $1"
    exit 1
  fi
}

require_cmd jq
require_cmd "$LIB_DIR"/api_get
require_cmd "$LIB_DIR"/api_patch
require_cmd "$LIB_DIR"/op_list
require_cmd "$LIB_DIR"/op_enum_status

# Open a dedicated TTY for prompts so we don't clash with stdin used for data
exec 3</dev/tty 2>/dev/null || {
  err "Nem található interaktív TTY. Futtasd terminálból."
  exit 1
}

ask() {
  # usage: ask "Prompt: " OUTVAR
  local __prompt="$1"
  local __outvar="$2"
  # Print prompt to stdout (visible in terminal)
  printf "%s" "$__prompt"
  # Read answer from tty (fd 3) so stdin remains free for any data streams
  IFS= read -r -u 3 "$__outvar"
}

# Filter out flags we cannot forward (like --table) to keep JSON output
OP_LIST_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --table) ;; # ignore, we need JSON
    *) OP_LIST_ARGS+=("$arg") ;;
  esac
done

# --- Fetch items via op_list (JSON, grouped by project) ---
LIST_JSON=$("$LIB_DIR"/op_list "${OP_LIST_ARGS[@]}")
if [ -z "$LIST_JSON" ]; then
  err "Az op_list nem adott vissza adatot."
  exit 1
fi

# --- Build flat array with explicit project field ---
FLAT_JSON=$(echo "$LIST_JSON" | jq -c '
  to_entries
  | map(. as $e | ($e.value | map(. + {project: $e.key})))
  | (add // [])
  | sort_by([.project, .id])
')
COUNT=$(echo "$FLAT_JSON" | jq 'length')
if [ "$COUNT" -eq 0 ]; then
  echo "Nincs feldolgozható jegy."
  exit 0
fi

# --- Preload enums: statuses and priorities ---

# Status name -> id
STATUSES_JSON=$("$LIB_DIR"/op_enum_status 2>/dev/null)
if [ -z "$STATUSES_JSON" ] || [ "$STATUSES_JSON" = "null" ]; then
  err "Nem sikerült lekérni a státusz listát."
  exit 1
fi

# Priority name -> id
PRIORITIES_JSON=$("$LIB_DIR"/api_get "/api/v3/priorities" | jq -c '._embedded.elements | map({key: .name, value: .id}) | from_entries')
if [ -z "$PRIORITIES_JSON" ] || [ "$PRIORITIES_JSON" = "null" ]; then
  err "Nem sikerült lekérni a prioritás listát."
  exit 1
fi

# Display helpers
list_statuses() {
  echo "$STATUSES_JSON" | jq -r 'to_entries | sort_by(.key) | .[] | "\(.value)\t\(.key)"'
}

list_priorities() {
  echo "$PRIORITIES_JSON" | jq -r 'to_entries | sort_by(.key) | .[] | "\(.value)\t\(.key)"'
}

# Lookup helper (accepts exact name or numeric id)
# usage: lookup_in_map <MAP_JSON> <INPUT>  => prints id or "null"
lookup_in_map() {
  local MAP_JSON="$1"
  local INPUT="$2"
  local RES
  if [[ "$INPUT" =~ ^[0-9]+$ ]]; then
    RES="$INPUT"
  else
    RES=$(echo "$MAP_JSON" | jq -r --arg name "$INPUT" '
      to_entries
      | map(select(.key == $name))
      | if length > 0 then .[0].value else null end
    ')
  fi
  [ -z "$RES" ] && RES="null"
  echo "$RES"
}

# Build PATCH payload for a ticket (merge fields)
# args: id status_id priority_id percent work
build_payload() {
  local ID="$1"
  local STATUS_ID="$2"
  local PRIORITY_ID="$3"
  local PERCENT="$4"
  local WORK="$5"

  local LOCK_VERSION
  LOCK_VERSION=$("$LIB_DIR"/api_get "/api/v3/work_packages/$ID" | jq -r '.lockVersion')
  if [ -z "$LOCK_VERSION" ] || [ "$LOCK_VERSION" = "null" ]; then
    err "Nem sikerült lockVersion-t lekérni (#$ID)"
    echo ""
    return 1
  fi

  # Start with lockVersion and an empty _links to enable safe setpath()
  local PAYLOAD
  PAYLOAD=$(jq -nc --argjson lv "$LOCK_VERSION" '{lockVersion: $lv, _links: {}}')

  if [ -n "$PERCENT" ]; then
    PAYLOAD=$(echo "$PAYLOAD" | jq --argjson pd "$PERCENT" '. + {percentageDone: $pd}')
  fi

  if [ -n "$WORK" ]; then
    PAYLOAD=$(echo "$PAYLOAD" | jq --arg work "$WORK" '. + {estimatedTime: $work}')
  fi

  if [ -n "$STATUS_ID" ]; then
    PAYLOAD=$(echo "$PAYLOAD" | jq --arg sid "$STATUS_ID" 'setpath(["_links","status","href"]; "/api/v3/statuses/"+$sid)')
  fi

  if [ -n "$PRIORITY_ID" ]; then
    PAYLOAD=$(echo "$PAYLOAD" | jq --arg pid "$PRIORITY_ID" 'setpath(["_links","priority","href"]; "/api/v3/priorities/"+$pid)')
  fi

  echo "$PAYLOAD"
  return 0
}

# --- Interactive loop over items ---
echo "Összesen $COUNT jegy. Enter = kihagyás, 'q' = kilépés."
echo

# Index-based iteration to avoid consuming stdin and to keep macOS Bash 3.2 compatibility
i=0
while [ "$i" -lt "$COUNT" ]; do
  ITEM=$(echo "$FLAT_JSON" | jq -c ".[$i]")

  ID=$(echo "$ITEM" | jq -r '.id')
  PROJECT=$(echo "$ITEM" | jq -r '.project')
  SUBJECT=$(echo "$ITEM" | jq -r '.subject')
  CURR_STATUS=$(echo "$ITEM" | jq -r '.status')
  CURR_PRIORITY=$(echo "$ITEM" | jq -r '.priority // ""')
  CURR_DONE=$(echo "$ITEM" | jq -r '.percentageDone')
  CURR_WORK=$(echo "$ITEM" | jq -r '.work // ""')

  echo "[$PROJECT] #$ID - $SUBJECT"
  echo "  status: $CURR_STATUS | priority: ${CURR_PRIORITY:-"-"} | done: ${CURR_DONE}% | work: ${CURR_WORK:-"-"}"

  # Ask whether to edit
  CH=""
  ask "Szerkeszted? [i=igen / Enter=nem / q=kilép] " CH
  case "$CH" in
    q|Q) echo "Megszakítva."; exit 0 ;;
    i|I) ;; # continue
    *) echo; i=$((i+1)); echo; continue ;;
  esac

  # --- STATUS ---
  NEW_STATUS_ID=""
  while true; do
    S=""
    ask "Új status (jelenlegi: '$CURR_STATUS', '?'=lista, Enter=nem változik): " S
    if [ -z "$S" ]; then
      break
    fi
    if [ "$S" == "?" ]; then
      echo "Elérhető státuszok (id  név):"
      list_statuses
      continue
    fi
    SID=$(lookup_in_map "$STATUSES_JSON" "$S")
    if [ "$SID" = "null" ]; then
      echo "Ismeretlen státusz: $S"
    else
      NEW_STATUS_ID="$SID"
      break
    fi
  done

  # --- PERCENTAGE DONE ---
  NEW_PERCENT=""
  while true; do
    P=""
    ask "Készültség % (0-100, jelenlegi: $CURR_DONE, Enter=nem változik): " P
    if [ -z "$P" ]; then
      break
    fi
    if [[ "$P" =~ ^[0-9]{1,3}$ ]] && [ "$P" -ge 0 ] && [ "$P" -le 100 ]; then
      NEW_PERCENT="$P"
      break
    else
      echo "Érvénytelen érték: $P"
    fi
  done

  # --- PRIORITY ---
  NEW_PRIORITY_ID=""
  while true; do
    R=""
    ask "Új prioritás (jelenlegi: '${CURR_PRIORITY:-"-"}', '?'=lista, Enter=nem változik): " R
    if [ -z "$R" ]; then
      break
    fi
    if [ "$R" == "?" ]; then
      echo "Elérhető prioritások (id  név):"
      list_priorities
      continue
    fi
    PID=$(lookup_in_map "$PRIORITIES_JSON" "$R")
    if [ "$PID" = "null" ]; then
      echo "Ismeretlen prioritás: $R"
    else
      NEW_PRIORITY_ID="$PID"
      break
    fi
  done

  # --- WORK ESTIMATE ---
  NEW_WORK=""
  while true; do
    W=""
    ask "Work becslés (jelenlegi: '${CURR_WORK:-"-"}', Enter=nem változik): " W
    if [ -z "$W" ]; then
      break
    fi
    NEW_WORK="$W"
    break
  done

  if [ -z "$NEW_STATUS_ID" ] && [ -z "$NEW_PERCENT" ] && [ -z "$NEW_PRIORITY_ID" ] && [ -z "$NEW_WORK" ]; then
    echo "Nincs változtatás."
    echo
    i=$((i+1))
    continue
  fi

  PAYLOAD=$(build_payload "$ID" "$NEW_STATUS_ID" "$NEW_PRIORITY_ID" "$NEW_PERCENT" "$NEW_WORK") || {
    echo "Kihagyva (#$ID)."
    echo
    i=$((i+1))
    continue
  }

  if [ -z "$PAYLOAD" ]; then
    echo "Üres payload, kihagyva."
    echo
    i=$((i+1))
    continue
  fi

  # Confirm and PATCH
  echo "Küldendő módosítás:"
  echo "$PAYLOAD" | jq

  APPLY=""
  ask "Alkalmazod? [y/N] " APPLY
  if [[ "$APPLY" =~ ^[Yy]$ ]]; then
    "$LIB_DIR"/api_patch "/api/v3/work_packages/$ID" "$PAYLOAD" >/dev/null
    echo "✅ #$ID frissítve."
  else
    echo "Kihagyva."
  fi

  echo
  i=$((i+1))
done

echo "Kész."
