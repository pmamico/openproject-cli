#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR"

if [ "$1" == "--summary" ]; then
  echo "Havi ASCII naptar sajat napi oraosszegekkel"
  exit 0
fi

if [ "$1" == "--desc" ]; then
  echo "Aktualis vagy megadott honapra ASCII naptar nezetet ad hetfo kezdettel, napi osszesitett munkaorakkal es szinezett cellakkal."
  echo "Hasznalat: op calendar [YYYY.MM|MM|honapnev|-N]"
  exit 0
fi

usage() {
  echo "Hasznalat: op calendar [YYYY.MM|MM|honapnev|-N]" >&2
  echo "Peldak: op calendar | op calendar 02 | op calendar jan | op calendar 2024.11 | op calendar -1" >&2
  exit 1
}

if [ "$#" -gt 1 ]; then
  usage
fi

is_darwin() {
  [[ "$OSTYPE" == "darwin"* ]]
}

to_int_month() {
  local m="$1"
  m=$((10#$m))
  if [ "$m" -lt 1 ] || [ "$m" -gt 12 ]; then
    return 1
  fi
  printf "%02d" "$m"
}

month_name_to_number() {
  local raw
  raw=$(printf "%s" "$1" | tr '[:upper:]' '[:lower:]')
  case "$raw" in
    jan|january|januar) echo "01" ;;
    feb|february|februar) echo "02" ;;
    mar|march|marcius) echo "03" ;;
    apr|april|aprilis) echo "04" ;;
    may|maj|majus) echo "05" ;;
    jun|june|junius) echo "06" ;;
    jul|july|julius) echo "07" ;;
    aug|august|augusztus) echo "08" ;;
    sep|sept|september|szept) echo "09" ;;
    oct|okt|october|oktober) echo "10" ;;
    nov|november) echo "11" ;;
    dec|december) echo "12" ;;
    *) return 1 ;;
  esac
}

shift_month_ym() {
  local y="$1"
  local m="$2"
  local delta="$3"
  local base="${y}-${m}-01"
  local shift

  if [ "$delta" -ge 0 ]; then
    shift="+${delta}"
  else
    shift="$delta"
  fi

  if is_darwin; then
    date -j -v"${shift}"m -f "%Y-%m-%d" "$base" +"%Y.%m"
  else
    date -d "$base ${delta} month" +"%Y.%m"
  fi
}

date_add_days() {
  local d="$1"
  local delta="$2"
  local shift

  if [ "$delta" -ge 0 ]; then
    shift="+${delta}"
  else
    shift="$delta"
  fi

  if is_darwin; then
    date -j -v"${shift}"d -f "%Y-%m-%d" "$d" +"%Y-%m-%d"
  else
    date -d "$d ${delta} day" +"%Y-%m-%d"
  fi
}

date_weekday_mon1() {
  local d="$1"
  if is_darwin; then
    date -j -f "%Y-%m-%d" "$d" +"%u"
  else
    date -d "$d" +"%u"
  fi
}

date_format_mmdd() {
  local d="$1"
  if is_darwin; then
    date -j -f "%Y-%m-%d" "$d" +"%m.%d"
  else
    date -d "$d" +"%m.%d"
  fi
}

date_month() {
  local d="$1"
  if is_darwin; then
    date -j -f "%Y-%m-%d" "$d" +"%m"
  else
    date -d "$d" +"%m"
  fi
}

date_day_number() {
  local d="$1"
  if is_darwin; then
    date -j -f "%Y-%m-%d" "$d" +"%d"
  else
    date -d "$d" +"%d"
  fi
}

format_hours() {
  LC_NUMERIC=C awk -v h="$1" 'BEGIN {
    v = h + 0
    if (v == int(v)) {
      printf "%d", int(v)
    } else {
      printf "%.1f", v
    }
  }'
}

CURRENT_YEAR=$(date +%Y)
CURRENT_MONTH=$(date +%m)
INPUT="${1:-}"

TARGET_YEAR=""
TARGET_MONTH=""

if [ -z "$INPUT" ]; then
  TARGET_YEAR="$CURRENT_YEAR"
  TARGET_MONTH="$CURRENT_MONTH"
elif [[ "$INPUT" =~ ^-[0-9]+$ ]]; then
  BACK="${INPUT#-}"
  TARGET_YM=$(shift_month_ym "$CURRENT_YEAR" "$CURRENT_MONTH" "-$BACK")
  TARGET_YEAR="${TARGET_YM%%.*}"
  TARGET_MONTH="${TARGET_YM##*.}"
elif [[ "$INPUT" =~ ^[0-9]{4}[.-][0-9]{2}$ ]]; then
  TARGET_YEAR="${INPUT%%[.-]*}"
  TARGET_MONTH="${INPUT##*[.-]}"
  TARGET_MONTH=$(to_int_month "$TARGET_MONTH") || usage
elif [[ "$INPUT" =~ ^[0-9]{1,2}$ ]]; then
  TARGET_MONTH=$(to_int_month "$INPUT") || usage
  if [ $((10#$TARGET_MONTH)) -le $((10#$CURRENT_MONTH)) ]; then
    TARGET_YEAR="$CURRENT_YEAR"
  else
    TARGET_YEAR="$((CURRENT_YEAR - 1))"
  fi
else
  TARGET_MONTH=$(month_name_to_number "$INPUT") || usage
  if [ $((10#$TARGET_MONTH)) -le $((10#$CURRENT_MONTH)) ]; then
    TARGET_YEAR="$CURRENT_YEAR"
  else
    TARGET_YEAR="$((CURRENT_YEAR - 1))"
  fi
fi

MONTH_START="${TARGET_YEAR}-${TARGET_MONTH}-01"
NEXT_MONTH_YM=$(shift_month_ym "$TARGET_YEAR" "$TARGET_MONTH" 1)
NEXT_MONTH_START="${NEXT_MONTH_YM%%.*}-${NEXT_MONTH_YM##*.}-01"
MONTH_END=$(date_add_days "$NEXT_MONTH_START" -1)
TODAY=$(date +%F)

ME_ID=$("$LIB_DIR"/api_get "/api/v3/users/me" | jq -r '.id // empty')
if [ -z "$ME_ID" ]; then
  echo "Nem sikerult lekerdezni a sajat felhasznalot." >&2
  exit 1
fi

PID=""
if [ -f ".op_info" ]; then
  PID=$(jq -r '.project_id // empty' ".op_info")
fi

FILTERS_JSON=$(jq -nc --arg uid "$ME_ID" --arg pid "$PID" '
  [
    {"user":{"operator":"=","values":["\($uid)"]}}
  ]
  + (if ($pid // "") != "" then [{"project":{"operator":"=","values":["\($pid)"]}}] else [] end)
')
FILTERS_ENC=$(printf '%s' "$FILTERS_JSON" | jq -sRr @uri)

tmp_pages="$(mktemp)"
TARGET_INDEX=$((10#$TARGET_YEAR * 12 + 10#$TARGET_MONTH))
CURRENT_INDEX=$((10#$CURRENT_YEAR * 12 + 10#$CURRENT_MONTH))

if [ "$TARGET_INDEX" -gt "$CURRENT_INDEX" ]; then
  DAY_SUMS_JSON='{}'
else
  MONTH_DIFF=$((CURRENT_INDEX - TARGET_INDEX))
  SORT_DIR="desc"
  if [ "$MONTH_DIFF" -gt 6 ]; then
    SORT_DIR="asc"
  fi

  SORT_JSON=$(jq -nc --arg dir "$SORT_DIR" '[["spentOn", $dir]]')
  SORT_ENC=$(printf '%s' "$SORT_JSON" | jq -sRr @uri)
  QUERY="/api/v3/time_entries?pageSize=200&filters=$FILTERS_ENC&sortBy=$SORT_ENC"

  while :; do
    RESPONSE=$("$LIB_DIR"/api_get "$QUERY")
    if [ -z "$RESPONSE" ]; then
      rm -f "$tmp_pages"
      echo "Nem erkezett valasz az API-tol." >&2
      exit 1
    fi

    if echo "$RESPONSE" | jq -e '._type? == "Error"' >/dev/null 2>&1; then
      rm -f "$tmp_pages"
      echo "API hiba (time_entries lekeres):" >&2
      echo "$RESPONSE" | jq >&2
      exit 1
    fi

    echo "$RESPONSE" \
      | jq -c --arg monthStart "$MONTH_START" --arg monthEnd "$MONTH_END" '
          [._embedded.elements[]? | select(.spentOn >= $monthStart and .spentOn <= $monthEnd)]
        ' >>"$tmp_pages"

    if [ "$SORT_DIR" = "desc" ]; then
      PAGE_MIN=$(echo "$RESPONSE" | jq -r '([._embedded.elements[]?.spentOn] | min) // empty')
      if [ -n "$PAGE_MIN" ] && [[ "$PAGE_MIN" < "$MONTH_START" ]]; then
        break
      fi
    else
      PAGE_MAX=$(echo "$RESPONSE" | jq -r '([._embedded.elements[]?.spentOn] | max) // empty')
      if [ -n "$PAGE_MAX" ] && [[ "$PAGE_MAX" > "$MONTH_END" ]]; then
        break
      fi
    fi

    NEXT_HREF=$(echo "$RESPONSE" | jq -r '._links.nextByOffset.href // empty')
    if [ -z "$NEXT_HREF" ]; then
      break
    fi
    QUERY="$NEXT_HREF"
  done

  DAY_SUMS_JSON=$(jq -s '
  def iso_to_hours:
    ( . // "" ) as $val
    | if ($val | test("^PT(?=[0-9.]+[HMS])(?:[0-9]+(?:\\.[0-9]+)?H)?(?:[0-9]+(?:\\.[0-9]+)?M)?(?:[0-9]+(?:\\.[0-9]+)?S)?$"))
      then (
        ($val | capture("^PT(?:(?<h>[0-9]+(?:\\.[0-9]+)?)H)?(?:(?<m>[0-9]+(?:\\.[0-9]+)?)M)?(?:(?<s>[0-9]+(?:\\.[0-9]+)?)S)?$")) as $d
        | (($d.h // "0") | tonumber)
          + ((($d.m // "0") | tonumber) / 60)
          + ((($d.s // "0") | tonumber) / 3600)
      )
      else 0
      end;

  (add // [])
  | map({day: .spentOn, hours: (.hours | iso_to_hours)})
  | reduce .[] as $e ({}; .[$e.day] = ((.[$e.day] // 0) + ($e.hours // 0)))
' "$tmp_pages")
fi

rm -f "$tmp_pages"

RANGE_W=15
CELL_W=12

RED="\033[31m"
YELLOW="\033[33m"
GREEN="\033[32m"
WHITE="\033[97m"
BOLD_WHITE="\033[1;97m"
RESET="\033[0m"

separator() {
  local i
  printf "+"
  printf -- "%*s" $((RANGE_W + 2)) "" | tr ' ' '-'
  printf "+"
  for i in 1 2 3 4 5 6 7; do
    printf -- "%*s" $((CELL_W + 2)) "" | tr ' ' '-'
    printf "+"
  done
  printf "\n"
}

print_centered_cell() {
  local text="$1"
  local width="$2"
  local len=${#text}
  local left=$(( (width - len) / 2 ))
  local right=$(( width - len - left ))
  if [ "$left" -lt 0 ]; then left=0; fi
  if [ "$right" -lt 0 ]; then right=0; fi
  printf " %*s%s%*s |" "$left" "" "$text" "$right" ""
}

center_text() {
  local text="$1"
  local width="$2"
  local len=${#text}
  local left=$(( (width - len) / 2 ))
  local right=$(( width - len - left ))
  if [ "$left" -lt 0 ]; then left=0; fi
  if [ "$right" -lt 0 ]; then right=0; fi
  printf "%*s%s%*s" "$left" "" "$text" "$right" ""
}

printf "OpenProject calendar: %s.%s\n" "$TARGET_YEAR" "$TARGET_MONTH"
separator
printf "| %-*s |" "$RANGE_W" "Het"
print_centered_cell "H" "$CELL_W"
print_centered_cell "K" "$CELL_W"
print_centered_cell "Sze" "$CELL_W"
print_centered_cell "Cs" "$CELL_W"
print_centered_cell "P" "$CELL_W"
print_centered_cell "Szo" "$CELL_W"
print_centered_cell "V" "$CELL_W"
printf "\n"
separator

FIRST_WDAY=$(date_weekday_mon1 "$MONTH_START")
CAL_START=$(date_add_days "$MONTH_START" "$((1 - FIRST_WDAY))")
LAST_WDAY=$(date_weekday_mon1 "$MONTH_END")
CAL_END=$(date_add_days "$MONTH_END" "$((7 - LAST_WDAY))")

WEEK_START="$CAL_START"
while [[ "$WEEK_START" < "$CAL_END" || "$WEEK_START" == "$CAL_END" ]]; do
  WEEK_END=$(date_add_days "$WEEK_START" 6)
  RANGE_LABEL="$(date_format_mmdd "$WEEK_START")-$(date_format_mmdd "$WEEK_END")"
  printf "| %-*s |" "$RANGE_W" "$RANGE_LABEL"

  for DAY_SHIFT in 0 1 2 3 4 5 6; do
    DAY=$(date_add_days "$WEEK_START" "$DAY_SHIFT")
    DAY_MONTH=$(date_month "$DAY")
    WEEKDAY=$(date_weekday_mon1 "$DAY")

    if [ "$DAY_MONTH" != "$TARGET_MONTH" ] || [ "$WEEKDAY" -ge 6 ] || [[ "$DAY" > "$TODAY" ]]; then
      printf " %-*s |" "$CELL_W" ""
      continue
    fi

    DAY_NUM=$(date_day_number "$DAY")
    DAY_NUM=$((10#$DAY_NUM))

    if [ "$DAY" == "$TODAY" ]; then
      DAY_LABEL=$(printf ">%02d" "$DAY_NUM")
      DAY_COLOR="$BOLD_WHITE"
    else
      DAY_LABEL=$(printf "%02d" "$DAY_NUM")
      DAY_COLOR="$WHITE"
    fi

    DAY_TEXT=$(printf "%-*s" "$CELL_W" "$DAY_LABEL")
    printf " %b%s%b |" "$DAY_COLOR" "$DAY_TEXT" "$RESET"
  done

  printf "\n"
  printf "| %-*s |" "$RANGE_W" ""

  for DAY_SHIFT in 0 1 2 3 4 5 6; do
    DAY=$(date_add_days "$WEEK_START" "$DAY_SHIFT")
    DAY_MONTH=$(date_month "$DAY")
    WEEKDAY=$(date_weekday_mon1 "$DAY")

    if [ "$DAY_MONTH" != "$TARGET_MONTH" ] || [ "$WEEKDAY" -ge 6 ] || [[ "$DAY" > "$TODAY" ]]; then
      printf " %-*s |" "$CELL_W" ""
      continue
    fi

    HOURS=$(printf '%s' "$DAY_SUMS_JSON" | jq -r --arg d "$DAY" '.[$d] // 0')
    HOURS_TXT=$(format_hours "$HOURS")
    CELL_TEXT=$(center_text "${HOURS_TXT}h" "$CELL_W")

    COLOR="$YELLOW"
    if awk -v h="$HOURS" 'BEGIN { exit !((h + 0) == 0) }'; then
      COLOR="$RED"
    elif awk -v h="$HOURS" 'BEGIN { exit !((h + 0) >= 8) }'; then
      COLOR="$GREEN"
    fi

    if [ "$DAY" == "$TODAY" ]; then
      case "$COLOR" in
        "$GREEN") COLOR="\033[1;32m" ;;
        "$YELLOW") COLOR="\033[1;33m" ;;
        "$RED") COLOR="\033[1;31m" ;;
      esac
    fi

    printf " %b%s%b |" "$COLOR" "$CELL_TEXT" "$RESET"
  done

  printf "\n"
  separator
  WEEK_START=$(date_add_days "$WEEK_START" 7)
done
